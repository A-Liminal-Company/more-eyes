generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Submission {
  id          String   @id @default(cuid())
  title       String
  description String
  language    String
  code        String
  createdAt   DateTime @default(now())
  // Grouping assignment from the optional model-assisted consensus pass, as
  // { v, groups: string[][] } of "<model>#<findingIndex>" keys. Null when the
  // pass is disabled or failed, in which case grouping falls back to the
  // deterministic lexical clustering at render time.
  consensus   Json?
  reviews     Review[]

  // Links a resubmission back to what it's re-reviewing, for delta tracking
  // (new/persistent/fixed findings). SetNull rather than Cascade: deleting the
  // predecessor shouldn't take a later, otherwise-independent submission with it.
  previousSubmissionId String?
  previous              Submission?  @relation("Resubmission", fields: [previousSubmissionId], references: [id], onDelete: SetNull)
  followups             Submission[] @relation("Resubmission")

  // "code" (default) or "diff" (a unified diff, reviewed hunk by hunk).
  format String @default("code")
}

model Review {
  id           String     @id @default(cuid())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String
  model        String
  // "ok" when the model returned a usable review, "failed" otherwise. One model
  // failing must not discard the reviews that succeeded.
  status       String
  summary      String?
  findings     Json?
  error        String?
  createdAt    DateTime   @default(now())

  @@index([submissionId])
}
