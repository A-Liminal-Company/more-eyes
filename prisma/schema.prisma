generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Submission {
  id          String   @id @default(cuid())
  title       String
  description String
  language    String
  code        String
  createdAt   DateTime @default(now())
  reviews     Review[]
}

model Review {
  id           String     @id @default(cuid())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String
  model        String
  // "ok" when the model returned a usable review, "failed" otherwise. One model
  // failing must not discard the reviews that succeeded.
  status       String
  summary      String?
  findings     Json?
  error        String?
  createdAt    DateTime   @default(now())

  @@index([submissionId])
}
