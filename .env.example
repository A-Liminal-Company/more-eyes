# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Shared secret gating access to the app. Generate one with:
#   openssl rand -hex 32
# Visit the app once with ?secret=<value> to set the access cookie.
APP_ACCESS_SECRET=

# Postgres. Railway injects this automatically; locally point it at your own.
# e.g. postgresql://USER@localhost:5432/code_review_dev
DATABASE_URL=

# https://openrouter.ai/keys — enables non-Anthropic reviewers
OPENROUTER_API_KEY=

# Per-attempt socket timeout, milliseconds (default 45000)
REVIEW_REQUEST_TIMEOUT_MS=
# Hard ceiling per model including retries, milliseconds (default 90000).
# Reviews run in parallel, so this bounds how long one slow model can hold up
# a whole submission.
REVIEW_DEADLINE_MS=

# Proxies in front of the app, for deriving the rate-limit key (default 1).
# X-Forwarded-For is read from the right, so a client cannot pick its own key.
# Only raise this if you put another proxy in front of Railway's.
TRUSTED_PROXY_HOPS=

# Model calls per minute across all clients combined (default 120). Bounds
# spend even when the per-client key is attacker-chosen.
RATE_LIMIT_GLOBAL_MAX=

# Optional: an OpenRouter model slug enabling the consensus merge pass, which
# groups findings that lexical matching leaves split because models paraphrased.
# Unset by default. Costs one extra model call per submission when enabled.
# e.g. google/gemini-3.5-flash
CONSENSUS_MERGE_MODEL=
