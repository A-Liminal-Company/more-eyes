# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Shared secret gating access to the app. Generate one with:
#   openssl rand -hex 32
# Visit the app once with ?secret=<value> to set the access cookie.
APP_ACCESS_SECRET=

DATABASE_URL="file:./dev.db"

# https://openrouter.ai/keys — enables non-Anthropic reviewers
OPENROUTER_API_KEY=

# Per-attempt socket timeout, milliseconds (default 45000)
REVIEW_REQUEST_TIMEOUT_MS=
# Hard ceiling per model including retries, milliseconds (default 90000).
# Reviews run in parallel, so this bounds how long one slow model can hold up
# a whole submission.
REVIEW_DEADLINE_MS=
